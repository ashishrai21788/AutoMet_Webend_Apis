# =============================================================================
# TEMPLATE ONLY — do not put real secrets in this file (it may be committed to git).
# Copy to ".env" in the same folder and fill in your real values:
#   cp .env.example .env
# Your previous/real configuration belongs in ".env" (usually gitignored), not here.
# =============================================================================

# MongoDB Connection (one database for both driver and user apps; see COLLECTIONS_OVERVIEW.md)
MONGODB_USERNAME=your_username
MONGODB_PASSWORD=your_password
MONGODB_CLUSTER=your_cluster.mongodb.net
DB_NAME=api_database
# Default driver collection name (used by models/driver.js; other collections are fixed in code)
COLLECTION_NAME=drivers

# Server Configuration
PORT=3000
# HOST=0.0.0.0
# NODE_ENV=development

# ---------------------------------------------------------------------------
# Ride hardening (see AUTOMET_RIDE_HARDENING_PLAN.md at workspace root)
# Rollout: local dev → Render production (no separate staging server)
# ---------------------------------------------------------------------------
AUTH_ENFORCEMENT=strict
SOCKET_AUTH_ENFORCEMENT=strict
CREATE_REQUEST_MODE=immediate

# Temporary rollback profile (legacy behavior — use only while debugging):
# AUTH_ENFORCEMENT=off
# SOCKET_AUTH_ENFORCEMENT=off
# CREATE_REQUEST_MODE=immediate

# Protect /api/v1/trips/check-timeouts and /api/v1/rides/check-timeouts
# SCHEDULER_SECRET=your_internal_cron_secret
# TRIP_DRIVER_RESPONSE_TIMEOUT_SECONDS=60

# JWT (driver/user auth; used by userController, otpController, dynamicController)
JWT_SECRET=your_super_secret_jwt_key_for_driver_authentication_2024

# Cloudinary (image uploads; used by config/cloudinary.js)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
# Alternative: single URL (optional; app uses the three vars above)
# CLOUDINARY_URL=cloudinary://your_api_key:your_api_secret@your_cloud_name

# ---------------------------------------------------------------------------
# Firebase Admin — required for FCM push (e.g. "new ride request" to driver on POST /api/v1/trips/create-request)
# Set one of the following. If none set, ride-request notifications cannot be sent.
# ---------------------------------------------------------------------------
# Option 1: Service account JSON string (recommended for production)
# FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account",...}
# Option 2: Path to service account JSON file (Firebase console → Project settings → Service accounts)
FIREBASE_SERVICE_ACCOUNT_PATH=./path/to/your-firebase-service-account.json
# Option 3: Google default credentials
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/credentials.json
# Note: FIREBASE_PROJECT_ID alone is NOT enough to send FCM — you need a service account JSON.
# Firestore drivers collection name (default: drivers) — legacy name in env; FCM uses drivers/users fcmToken in MongoDB
# FIRESTORE_DRIVERS_COLLECTION=drivers
